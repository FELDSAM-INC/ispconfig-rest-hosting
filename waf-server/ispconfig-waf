#!/bin/bash
set -euo pipefail
[[ $(id -u) = 0 ]] || { echo 'Run as root.' >&2; exit 1; }
case "${1:-status}" in
    atomic-key)
        read -r -s -p 'Atomicorp server API key: ' waf_license_key </dev/tty
        printf '\n' >/dev/tty
        printf '%s\n' "$waf_license_key" | php /usr/local/lib/ispconfig-rest-waf/configure.php atomic-key
        unset waf_license_key
        ;;
    status|atomic-disable|refresh)
        php /usr/local/lib/ispconfig-rest-waf/configure.php "${1:-status}"
        ;;
    bans)
        # Clients banned by the WAF jails (spec 048) on this server's HTTP/HTTPS.
        for jail in ispconfig-waf ispconfig-waf-recidive; do
            fail2ban-client status "$jail" || { echo "fail2ban jail $jail is not running (fail2ban-client -t)." >&2; exit 1; }
        done
        ;;
    unban)
        address=${2:-}
        [[ $address =~ ^[0-9A-Fa-f:.]{2,45}$ ]] && php -r 'exit(filter_var($argv[1], FILTER_VALIDATE_IP) ? 0 : 1);' "$address" || { echo 'Usage: ispconfig-waf unban ADDRESS' >&2; exit 1; }
        for jail in ispconfig-waf ispconfig-waf-recidive; do fail2ban-client set "$jail" unbanip "$address" >/dev/null 2>&1 || true; done
        echo "Unbanned $address. Add it to /etc/ispconfig-waf/ban-ignore.conf to never ban it again."
        ;;
    *) echo 'Usage: ispconfig-waf status|bans|unban ADDRESS|atomic-key|atomic-disable|refresh' >&2; exit 1;;
esac
